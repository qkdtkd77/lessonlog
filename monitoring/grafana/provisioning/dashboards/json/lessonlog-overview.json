            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{application=\"lessonlog\"}[$__rate_interval]) / rate(hikaricp_connections_acquire_seconds_count{application=\"lessonlog\"}[$__rate_interval])",
          "legendFormat": "평균 획득 시간"
        }
