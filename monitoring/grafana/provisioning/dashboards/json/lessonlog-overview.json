{
  "uid": "lessonlog-overview",
  "title": "LessonLog 개요",
  "tags": [
    "lessonlog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "요청 수 (RPS)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval]))",
          "legendFormat": "전체"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "오류율",
      "description": "전체 요청 중 오류 응답 비율. 4xx에는 의도한 404(다른 선생님 데이터 접근)도 포함된다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "legendFormat": "5xx",
          "expr": "(sum(rate(http_server_requests_seconds_count{application=\"lessonlog\", uri!=\"/actuator/prometheus\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval]))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "legendFormat": "4xx",
          "expr": "(sum(rate(http_server_requests_seconds_count{application=\"lessonlog\", uri!=\"/actuator/prometheus\", status=~\"4..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "응답 시간 p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval])))",
          "legendFormat": "전체"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "응답 시간 p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
