        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "tomcat_threads_config_max_threads{application=\"lessonlog\"}",
          "legendFormat": "최대"
        }
      ]
    },
