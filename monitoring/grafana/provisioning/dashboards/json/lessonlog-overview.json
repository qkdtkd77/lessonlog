          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval])))",
          "legendFormat": "전체"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{application=\"lessonlog\", uri!=\"/actuator/prometheus\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "서버 자원",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HikariCP 커넥션",
      "description": "pending이 0보다 커지면 커넥션 풀이 병목이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hikaricp_connections_active{application=\"lessonlog\"}",
          "legendFormat": "사용 중"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "hikaricp_connections_idle{application=\"lessonlog\"}",
          "legendFormat": "대기 중(유휴)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "hikaricp_connections_pending{application=\"lessonlog\"}",
          "legendFormat": "커넥션을 기다리는 요청"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "hikaricp_connections_max{application=\"lessonlog\"}",
          "legendFormat": "최대"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tomcat 스레드",
      "description": "server.tomcat.mbeanregistry.enabled가 true여야 수집된다.",
      "datasource": {
        "type": "prometheus",
